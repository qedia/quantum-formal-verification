import Qhl.Register.TFIMLocality
import Qhl.HSpace.LocalCommutator
import Qhl.HSpace.HamiltonianTrotter

/-!
# Approximation of transverse-field Ising evolution

The target evolution is the operator exponential of the sum of the two
independently defined Hamiltonians. The exact product-formula identities
remain in `TFIM`; this module provides the analytical approximation facts.
-/

namespace Qhl.TrotterTFIM
open Qhl Finset
open scoped ComplexInnerProductSpace

variable (n : ℕ) (ca : Fin n → ℝ) (cb : Fin (n - 1) → ℝ)

theorem isSymmetric_HX : (HX n ca).IsSymmetric := by
  apply isSymmetric_of_real_eigenbasis (pmBasis n)
    (by simpa only [pmBasis, coe_basisOfOrthonormalOfCardEqFinrank] using orthonormal_pmState n)
    (HX n ca) (xEnergy n ca n)
  intro s
  simpa only [pmBasis, coe_basisOfOrthonormalOfCardEqFinrank] using HX_pmState n ca s

theorem isSymmetric_HZZ : (HZZ n cb).IsSymmetric := by
  apply isSymmetric_of_real_eigenbasis
    (EuclideanSpace.basisFun (QIdx (QubitD n) (univ : Finset (QubitL n))) ℂ).toBasis
    (EuclideanSpace.basisFun _ ℂ).orthonormal (HZZ n cb) (coupleE n cb (n - 1))
  intro s
  simpa only [OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply, deltav] using
    HZZ_deltav n cb s

/-- The target Hamiltonian, including both transverse fields and couplings. -/
noncomputable def hamiltonian : EndM (QubitD n) (univ : Finset (QubitL n)) :=
  HX n ca + HZZ n cb

theorem isSymmetric_hamiltonian : (hamiltonian n ca cb).IsSymmetric :=
  (isSymmetric_HX n ca).add (isSymmetric_HZZ n cb)

/-- The target evolution generated by the full Hamiltonian. -/
noncomputable def evolution (θ : ℝ) : EndM (QubitD n) (univ : Finset (QubitL n)) :=
  expOp ((-(Complex.I * (θ : ℂ))) • hamiltonian n ca cb)

theorem norm_evolution (θ : ℝ) (ψ : HS (QubitD n) (univ : Finset (QubitL n))) :
    ‖evolution n ca cb θ ψ‖ = ‖ψ‖ := by
  exact norm_exp_negI_smul_apply (hamiltonian n ca cb) (isSymmetric_hamiltonian n ca cb) θ ψ

private theorem norm_toContinuousLinearMap_le_one_of_isUnitary
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [FiniteDimensional ℂ E]
    (U : E →ₗ[ℂ] E) (hU : IsUnitary U) : ‖U.toContinuousLinearMap‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro v
  change ‖U v‖ ≤ 1 * ‖v‖
  simpa only [one_mul] using
    ((LinearMap.norm_map_iff_inner_map_map U).mpr hU.isIsometryOp v).le

/-- Only the two transverse-field terms incident to a coupling contribute
 to its commutator; the resulting bound is independent of Hilbert-space dimension. -/
theorem norm_commutator_HX_HZZ_le_coefficients :
    ‖(HX n ca).toContinuousLinearMap * (HZZ n cb).toContinuousLinearMap -
      (HZZ n cb).toContinuousLinearMap * (HX n ca).toContinuousLinearMap‖ ≤
      2 * ∑ j : Fin (n - 1), |cb j| * (|ca (loCell n j)| + |ca (hiCell n j)|) := by
  let Xs := fun i : Fin n => (gateAt (QubitL n) i X).toContinuousLinearMap
  let Zs := fun j : Fin (n - 1) =>
    (regLift (D := QubitD n) (Reg.pair (loCell n j) (hiCell n j) (loCell_ne_hiCell n j))
      (pairGate (D := QubitD n) (loCell n j) (hiCell n j)
        (loCell_ne_hiCell n j) ZZ)).toContinuousLinearMap
  have h := norm_commutator_sum_le_of_two_sites Xs Zs ca cb
    (loCell n) (hiCell n) (loCell_ne_hiCell n)
    (fun i => norm_toContinuousLinearMap_le_one_of_isUnitary _ (isUnitary_gateAt _ _ _))
    (fun j => norm_toContinuousLinearMap_le_one_of_isUnitary _ (isUnitary_regLift _ _))
    (fun i j hia hib => congrArg
      (Module.End.toContinuousLinearMap (𝕜 := ℂ) (HS (QubitD n) (univ : Finset (QubitL n))))
      (gateAt_X_comm_regLift_ZZ n i (loCell n j) (hiCell n j)
        (loCell_ne_hiCell n j) hia hib))
  simpa only [HX, HZZ, map_sum, map_smul, Xs, Zs] using h

/-- The first-order commutator bound for `N` Trotter slices. -/
noncomputable def trotterErrorBound (N : ℕ) (θ : ℝ) : ℝ :=
  θ ^ 2 / (2 * (N : ℝ)) *
    ‖(HX n ca).toContinuousLinearMap * (HZZ n cb).toContinuousLinearMap -
      (HZZ n cb).toContinuousLinearMap * (HX n ca).toContinuousLinearMap‖

theorem trotterErrorBound_nonneg (N : ℕ) (θ : ℝ) :
    0 ≤ trotterErrorBound n ca cb N θ := by
  apply mul_nonneg
  · exact div_nonneg (sq_nonneg θ) (mul_nonneg (by norm_num) (Nat.cast_nonneg N))
  · exact norm_nonneg _

/-- The abstract commutator error is bounded explicitly by the coefficients. -/
theorem trotterErrorBound_le_coefficients (N : ℕ) (θ : ℝ) :
    trotterErrorBound n ca cb N θ ≤
      θ ^ 2 / (N : ℝ) * ∑ j : Fin (n - 1),
        |cb j| * (|ca (loCell n j)| + |ca (hiCell n j)|) := by
  unfold trotterErrorBound
  calc
    _ ≤ θ ^ 2 / (2 * (N : ℝ)) *
        (2 * ∑ j : Fin (n - 1), |cb j| * (|ca (loCell n j)| + |ca (hiCell n j)|)) :=
      mul_le_mul_of_nonneg_left (norm_commutator_HX_HZZ_le_coefficients n ca cb)
        (div_nonneg (sq_nonneg θ) (mul_nonneg (by norm_num) (Nat.cast_nonneg N)))
    _ = _ := by ring

/-- The implemented product formula approximates the full Hamiltonian evolution. -/
theorem norm_product_sub_evolution_le (N : ℕ) [NeZero N] (θ : ℝ) :
    ‖((WOp n ca cb (θ / (N : ℝ))) ^ N).toContinuousLinearMap -
      (evolution n ca cb θ).toContinuousLinearMap‖ ≤ trotterErrorBound n ca cb N θ := by
  have h := hamiltonian_product_formula_error (HX n ca) (HZZ n cb)
    (isSymmetric_HX n ca) (isSymmetric_HZZ n cb) θ N
  have hW : (WOp n ca cb (θ / (N : ℝ))).toContinuousLinearMap =
      NormedSpace.exp ((-(Complex.I * ((θ / N : ℝ) : ℂ))) • (HZZ n cb).toContinuousLinearMap) *
      NormedSpace.exp ((-(Complex.I * ((θ / N : ℝ) : ℂ))) • (HX n ca).toContinuousLinearMap) := by
    rw [WOp, BOp_eq_expOp, AOp_eq_expOp]
    rfl
  have hp : ((WOp n ca cb (θ / (N : ℝ))) ^ N).toContinuousLinearMap =
      ((WOp n ca cb (θ / (N : ℝ))).toContinuousLinearMap) ^ N := by
    exact (Module.End.toContinuousLinearMap (𝕜 := ℂ) _).map_pow _ _
  rw [hp, hW]
  exact h

/-- The implemented product formula has an explicit coefficient-dependent error. -/
theorem norm_product_sub_evolution_le_coefficients (N : ℕ) [NeZero N] (θ : ℝ) :
    ‖((WOp n ca cb (θ / (N : ℝ))) ^ N).toContinuousLinearMap -
      (evolution n ca cb θ).toContinuousLinearMap‖ ≤
      θ ^ 2 / (N : ℝ) * ∑ j : Fin (n - 1),
        |cb j| * (|ca (loCell n j)| + |ca (hiCell n j)|) :=
  (norm_product_sub_evolution_le n ca cb N θ).trans
    (trotterErrorBound_le_coefficients n ca cb N θ)

/-- An operator-norm estimate applies to every unit input state. -/
theorem norm_wIter_sub_evolution_of_norm_le (N : ℕ) (θ : ℝ)
    (ψ : HS (QubitD n) (univ : Finset (QubitL n))) (hψ : ‖ψ‖ = 1)
    (ε : ℝ)
    (hε : ‖((WOp n ca cb (θ / (N : ℝ))) ^ N).toContinuousLinearMap -
      (evolution n ca cb θ).toContinuousLinearMap‖ ≤ ε) :
    ‖wIter n ca cb (θ / (N : ℝ)) ψ N - evolution n ca cb θ ψ‖ ≤ ε := by
  rw [wIter_eq_pow]
  change ‖((((WOp n ca cb (θ / (N : ℝ))) ^ N).toContinuousLinearMap -
    (evolution n ca cb θ).toContinuousLinearMap) ψ)‖ ≤ ε
  exact (ContinuousLinearMap.le_opNorm _ ψ).trans (by simpa [hψ] using hε)

end Qhl.TrotterTFIM
